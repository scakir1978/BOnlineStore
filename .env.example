# --- BOnlineStore example environment variables ---
# Bu dosya bir örnektir. Güçlü parolalar kullanın ve bu dosyayı doğrudan kullanmayın.
# Üretim için K8s Secret / CI değişkenleri önerilir.

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=ChangeMe_Strong_#2025

# SQL Server (IdentityDB)
MSSQL_SA_PASSWORD=ChangeMe_Strong_#2025

# Optional: Docker Hub (lokalde gerekmez, CI için gereklidir)
DOCKERHUB_USERNAME=
DOCKERHUB_PASSWORD=

# Host adları (isteğe bağlı, compose dosyalarında değişkenleştirmek için)
UI_HOST=ui.b-online-store.com
GATEWAY_HOST=gateway.b-online-store.com
IDENTITY_HOST=identity.b-online-store.com
DEFINITIONS_HOST=definitions.b-online-store.com
PRODUCTION_HOST=production.b-online-store.com
ORDER_HOST=order.b-online-store.com
BFF_HOST=bff.b-online-store.com

# Seq
SEQ_ACCEPT_EULA=Y
